{
  "name": "@northbook/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --import tsx ../../scripts/generate-state-diagrams.ts && next build --webpack && node ../../scripts/prepare-web.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "dev": "node --import tsx ../../scripts/generate-state-diagrams.ts && next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@northbook/shared": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
