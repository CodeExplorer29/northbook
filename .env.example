# Configuration template for local development and deployment.
# Copy to .env and fill in local values. Never commit credentials.
# pnpm dev generates a local .env with random credentials when none exists.

# Docker Compose owner password and local port.
POSTGRES_PASSWORD=
POSTGRES_PORT=55432

# Signed persona session cookie. Generate a local secret before running.
SESSION_SECRET=

# Restricted application role: all ordinary request handling.
DATABASE_URL=

# Owner role: migrations and seed only.
DATABASE_ADMIN_URL=

# Password used to create the restricted application role.
DATABASE_APP_PASSWORD=

# Market data source: live or replay.
PRICING_MODE=replay

# Maximum venue data age in milliseconds.
VENUE_STALENESS_THRESHOLD_MS=5000

LOG_LEVEL=info

# Shared web/server proxy authentication (at least 32 random characters).
# pnpm dev supplies an ephemeral secret when this is blank.
PROXY_SECRET=
# Set to railway only behind Railway public HTTP ingress; local mode ignores incoming IP headers.
CLIENT_IP_SOURCE=local
# Positive request limits; HTTP and SSE price connections share their minute bucket.
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_QUOTES=30
RATE_LIMIT_ORGANISATION=30
